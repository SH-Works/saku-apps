## Execute Transfer Use Case — execute_transfer.dart
```dart
// Atomically:
// 1. Validate sufficient balance in fromWallet
// 2. Deduct amount from fromWallet balance
// 3. Add amount to toWallet balance
// 4. Save transfer record to Hive

class ExecuteTransfer {
  final TransferRepository transferRepo;
  final WalletRepository walletRepo;

  ExecuteTransfer(this.transferRepo, this.walletRepo);

  Future<void> call(WalletTransfer transfer) async {
    // Validate source wallet
    final fromWallet = await walletRepo.getWalletById(transfer.fromWalletId);
    if (fromWallet == null) throw Exception('Source wallet not found');
    if (fromWallet.balance < transfer.amount) {
      throw Exception('Insufficient balance');
    }

    // Deduct from source wallet
    await walletRepo.updateWallet(
      fromWallet.copyWith(balance: fromWallet.balance - transfer.amount),
    );

    // Add to destination wallet
    final toWallet = await walletRepo.getWalletById(transfer.toWalletId);
    if (toWallet == null) throw Exception('Destination wallet not found');
    await walletRepo.updateWallet(
      toWallet.copyWith(balance: toWallet.balance + transfer.amount),
    );

    // Save transfer record
    await transferRepo.executeTransfer(transfer);
  }
}
```

