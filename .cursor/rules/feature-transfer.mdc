```dart
abstract class TransferRepository {
  Future<List<WalletTransfer>> getAllTransfers();
  Future<List<WalletTransfer>> getTransfersByWallet(String walletId);
  Future<void> executeTransfer(WalletTransfer transfer);
  Future<void> deleteTransfer(String id);
}
