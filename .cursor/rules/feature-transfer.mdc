## Datasource — transfer_local_datasource.dart
```dart
class TransferLocalDatasource {
  final Box<WalletTransferModel> _box;
  TransferLocalDatasource(this._box);

  Future<List<WalletTransfer>> getAllTransfers() async {
    return _box.values.map((m) => m.toEntity()).toList()
      ..sort((a, b) => b.date.compareTo(a.date));
  }

  Future<List<WalletTransfer>> getTransfersByWallet(String walletId) async {
    return _box.values
        .where((m) =>
            m.fromWalletId == walletId || m.toWalletId == walletId)
        .map((m) => m.toEntity())
        .toList()
      ..sort((a, b) => b.date.compareTo(a.date));
  }

  Future<void> saveTransfer(WalletTransfer transfer) async {
    final model = WalletTransferModel.fromEntity(transfer);
    await _box.put(transfer.id, model);
  }

  Future<void> deleteTransfer(String id) async {
    await _box.delete(id);
  }
}
```

