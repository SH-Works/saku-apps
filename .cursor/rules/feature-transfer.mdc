## Riverpod Provider — transfer_provider.dart
```dart
final transferRepositoryProvider = Provider<TransferRepository>((ref) {
  final box = Hive.box<WalletTransferModel>('wallet_transfers');
  final datasource = TransferLocalDatasource(box);
  return TransferRepositoryImpl(datasource);
});

final executeTransferProvider = Provider<ExecuteTransfer>((ref) {
  return ExecuteTransfer(
    ref.read(transferRepositoryProvider),
    ref.read(walletRepositoryProvider),
  );
});

final deleteTransferProvider = Provider<DeleteTransfer>((ref) {
  return DeleteTransfer(
    ref.read(transferRepositoryProvider),
    ref.read(walletRepositoryProvider),
  );
});

final allTransfersProvider = FutureProvider<List<WalletTransfer>>((ref) async {
  return ref.read(transferRepositoryProvider).getAllTransfers();
});

final transfersByWalletProvider =
    FutureProvider.family<List<WalletTransfer>, String>((ref, walletId) async {
  return ref.read(transferRepositoryProvider).getTransfersByWallet(walletId);
});
```

