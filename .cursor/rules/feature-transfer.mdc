## Delete Transfer Use Case — delete_transfer.dart
```dart
// On delete: REVERSE the wallet balances
// Add amount back to fromWallet, deduct from toWallet

class DeleteTransfer {
  final TransferRepository transferRepo;
  final WalletRepository walletRepo;

  DeleteTransfer(this.transferRepo, this.walletRepo);

  Future<void> call(WalletTransfer transfer) async {
    // Reverse: add back to fromWallet
    final fromWallet = await walletRepo.getWalletById(transfer.fromWalletId);
    if (fromWallet != null) {
      await walletRepo.updateWallet(
        fromWallet.copyWith(balance: fromWallet.balance + transfer.amount),
      );
    }

    // Reverse: deduct from toWallet
    final toWallet = await walletRepo.getWalletById(transfer.toWalletId);
    if (toWallet != null) {
      await walletRepo.updateWallet(
        toWallet.copyWith(balance: toWallet.balance - transfer.amount),
      );
    }

    // Delete transfer record
    await transferRepo.deleteTransfer(transfer.id);
  }
}
```

