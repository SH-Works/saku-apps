## Abstract Repository — smoke_repository.dart
```dart
abstract class SmokeRepository {
  // Logs
  Future<void> logCigarette(SmokeLog log);
  Future<void> deleteSmokeLog(String id);
  Future<List<SmokeLog>> getLogsByDay(DateTime date);
  Future<List<SmokeLog>> getLogsByMonth(int year, int month);
  Future<Map<DateTime, int>> getDailyCountByMonth(int year, int month);
  // Returns: { date: count } map for chart

  // Settings
  Future<SmokeSettings?> getSettings();
  Future<void> saveSettings(SmokeSettings settings);

  // Statistics
  Future<SmokeStatistics> getStatistics(int year, int month);
}

// Statistics data class
class SmokeStatistics {
  final int totalThisMonth;
  final int totalLastMonth;
  final double averagePerDay;
  final int highestDay;           // max in a single day
  final int lowestDay;            // min in a single day (days with logs)
  final int totalCostThisMonth;   // in IDR
  final int daysUnderLimit;       // days below daily limit
  final int daysOverLimit;        // days above daily limit
}
