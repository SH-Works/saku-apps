## Riverpod Providers — smoke_provider.dart
```dart
final smokeRepositoryProvider = Provider<SmokeRepository>((ref) {
  final logBox = Hive.box<SmokeLogModel>('smoke_logs');
  final settingsBox = Hive.box<SmokeSettingsModel>('smoke_settings');
  return SmokeRepositoryImpl(
    SmokeLogDatasource(logBox),
    SmokeSettingsDatasource(settingsBox),
  );
});

final logCigaretteProvider = Provider<LogCigarette>((ref) {
  return LogCigarette(
    ref.read(smokeRepositoryProvider),
    ref.read(transactionRepositoryProvider),
  );
});

final todayLogsProvider = FutureProvider<List<SmokeLog>>((ref) async {
  final now = DateTime.now();
  return ref.read(smokeRepositoryProvider).getLogsByDay(
    DateTime(now.year, now.month, now.day),
  );
});

final todayCountProvider = Provider<int>((ref) {
  return ref.watch(todayLogsProvider).value?.length ?? 0;
});

final smokeSettingsProvider = FutureProvider<SmokeSettings?>((ref) async {
  return ref.read(smokeRepositoryProvider).getSettings();
});

final smokeDailyChartProvider =
    FutureProvider.family<Map<DateTime, int>, ({int year, int month})>(
        (ref, params) async {
  return ref.read(smokeRepositoryProvider)
      .getDailyCountByMonth(params.year, params.month);
});

final smokeStatisticsProvider =
    FutureProvider.family<SmokeStatistics, ({int year, int month})>(
        (ref, params) async {
  return ref.read(smokeRepositoryProvider)
      .getStatistics(params.year, params.month);
});

// Master toggle provider
final smokeTrackerEnabledProvider = StateProvider<bool>((ref) {
  final settings = ref.watch(smokeSettingsProvider).value;
  return settings?.isEnabled ?? false;
});

// Toggle use case — enable or disable the entire feature
final toggleSmokeTrackerProvider = Provider<ToggleSmokeTracker>((ref) {
  return ToggleSmokeTracker(ref.read(smokeRepositoryProvider));
});
```

## Toggle Use Case — toggle_smoke_tracker.dart
```dart
class ToggleSmokeTracker {
  final SmokeRepository smokeRepo;
  ToggleSmokeTracker(this.smokeRepo);

  Future<void> call(bool enabled) async {
    final current = await smokeRepo.getSettings() ?? SmokeSettings.defaults();
    await smokeRepo.saveSettings(current.copyWith(isEnabled: enabled));
  }
}
```

