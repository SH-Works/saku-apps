## Navigation & Access Points

### From Settings Page — with Active/Inactive Toggle
```dart
// In settings_page.dart under Section "Tools"
// Shows toggle ON/OFF + chevron to open tracker (only when enabled)

Consumer(
  builder: (context, ref, _) {
    final isEnabled = ref.watch(smokeTrackerEnabledProvider);
    return Column(
      children: [
        // Row 1: Enable/disable toggle
        ListTile(
          leading: const Text('🚬', style: TextStyle(fontSize: 20)),
          title: const Text('Smoke Tracker'),
          subtitle: Text(
            isEnabled ? 'Tap to open tracker' : 'Enable to track cigarettes',
            style: const TextStyle(fontSize: 12, color: Color(0xFF8E8E93)),
          ),
          trailing: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Switch.adaptive(
                value: isEnabled,
                activeColor: Colors.black,
                onChanged: (val) async {
                  // If enabling for the first time → show onboarding sheet
                  if (val) {
                    final settings = await ref
                        .read(smokeRepositoryProvider)
                        .getSettings();
                    if (settings == null || settings.cigarettesPerPack == 0) {
                      // Show setup bottom sheet before enabling
                      await showModalBottomSheet(
                        context: context,
                        isScrollControlled: true,
                        builder: (_) => const SmokeOnboardingSheet(),
                      );
                    }
                  }
                  await ref
                      .read(toggleSmokeTrackerProvider)
                      .call(val);
                  ref.invalidate(smokeSettingsProvider);
                },
              ),
              if (isEnabled) ...[
                const SizedBox(width: 8),
                const Icon(Icons.chevron_right, color: Color(0xFF8E8E93)),
              ],
            ],
          ),
          onTap: isEnabled ? () => context.push('/smoke') : null,
        ),
      ],
    );
  },
)
```

