## Log Cigarette Use Case — log_cigarette.dart
```dart
class LogCigarette {
  final SmokeRepository smokeRepo;
  final TransactionRepository transactionRepo;

  LogCigarette(this.smokeRepo, this.transactionRepo);

  Future<void> call({String? notes}) async {
    final now = DateTime.now();

    // 1. Save smoke log
    final log = SmokeLog(
      id: const Uuid().v4(),
      loggedAt: now,
      date: DateTime(now.year, now.month, now.day),
      notes: notes,
      createdAt: now,
    );
    await smokeRepo.logCigarette(log);

    // 2. Check settings
    final settings = await smokeRepo.getSettings();
    if (settings == null) return;

    // 3. Auto-log expense if enabled
    // Only log expense once per pack consumed
    // i.e. every [cigarettesPerPack] cigarettes = 1 pack expense
    if (settings.autoLogExpense) {
      final todayLogs = await smokeRepo.getLogsByDay(
        DateTime(now.year, now.month, now.day),
      );
      if (todayLogs.length % settings.cigarettesPerPack == 0) {
        // One full pack consumed → add expense
        final tx = Transaction(
          id: const Uuid().v4(),
          type: TransactionType.expense,
          amount: settings.pricePerPack,
          categoryId: 'smoke',         // new category
          walletId: settings.expenseWalletId,
          date: now,
          notes: 'Cigarettes — 1 pack',
          createdAt: now,
        );
        await transactionRepo.addTransaction(tx);
      }
    }

    // 4. Check daily limit notifications
    final todayCount = (await smokeRepo.getLogsByDay(
      DateTime(now.year, now.month, now.day),
    )).length;

    if (settings.notifyAt80Percent) {
      final threshold = (settings.dailyLimit * 0.8).floor();
      if (todayCount == threshold) {
        // Trigger local notification
        await _notify(
          title: '⚠ Smoke Limit Warning',
          body: 'You\'ve smoked $todayCount/${settings.dailyLimit} cigarettes today.',
        );
      }
    }

    if (settings.notifyAtLimit && todayCount >= settings.dailyLimit) {
      await _notify(
        title: '🚫 Daily Limit Reached',
        body: 'You\'ve reached your daily limit of ${settings.dailyLimit} cigarettes.',
      );
    }
  }
}
```

