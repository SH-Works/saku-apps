## Smoke Log Entity — smoke_log.dart
```dart
import 'package:freezed_annotation/freezed_annotation.dart';
part 'smoke_log.freezed.dart';

@freezed
class SmokeLog with _$SmokeLog {
  const factory SmokeLog({
    required String id,
    required DateTime loggedAt,   // exact timestamp of each cigarette
    required DateTime date,       // date only (for grouping by day)
    String? notes,                // optional e.g. "after lunch", "stress"
    required DateTime createdAt,
  }) = _SmokeLog;
}
```

## Smoke Settings Entity — smoke_settings.dart
```dart
// Stored in Hive 'smoke_settings' box as a single record

@freezed
class SmokeSettings with _$SmokeSettings {
  const factory SmokeSettings({
    required bool isEnabled,          // master toggle — ON/OFF for the whole feature
    required int dailyLimit,          // max cigarettes per day
    required int cigarettesPerPack,   // how many cigarettes in 1 pack
    required int pricePerPack,        // price per pack in IDR
    required bool notifyAtLimit,      // notify when daily limit reached
    required bool notifyAt80Percent,  // notify at 80% of daily limit
    required bool autoLogExpense,     // auto-add to Saku transactions
    required String expenseWalletId,  // which wallet to deduct from
  }) = _SmokeSettings;

  // Default settings — feature OFF by default
  factory SmokeSettings.defaults() => const SmokeSettings(
    isEnabled: false,
    dailyLimit: 15,
    cigarettesPerPack: 20,
    pricePerPack: 25000,
    notifyAtLimit: true,
    notifyAt80Percent: true,
    autoLogExpense: false,
    expenseWalletId: '',
  );
}

// Computed helpers:
// pricePerCigarette = pricePerPack / cigarettesPerPack
// dailyCost(count) = count * pricePerCigarette
// monthlyCost = sum of all daily costs in a month
```

