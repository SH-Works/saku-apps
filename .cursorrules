## Categories Constant
```dart
class TransactionCategory {
  final String id;
  final String label;
  final String icon;
  const TransactionCategory({
    required this.id,
    required this.label,
    required this.icon,
  });
}

const List<TransactionCategory> kCategories = [
  TransactionCategory(id: 'food',          label: 'Food & Drinks',   icon: '🍽️'),
  TransactionCategory(id: 'transport',     label: 'Transportation',  icon: '🚗'),
  TransactionCategory(id: 'shopping',      label: 'Shopping',        icon: '🛍️'),
  TransactionCategory(id: 'health',        label: 'Health',          icon: '🏥'),
  TransactionCategory(id: 'entertainment', label: 'Entertainment',   icon: '🎮'),
  TransactionCategory(id: 'education',     label: 'Education',       icon: '📚'),
  TransactionCategory(id: 'household',     label: 'Household',       icon: '🏠'),
  TransactionCategory(id: 'salary',        label: 'Salary / Income', icon: '💼'),
  TransactionCategory(id: 'other',         label: 'Others',          icon: '📦'),
];
```

